    "# module imports\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from tensorflow.keras.datasets import mnist\n",
    "from sklearn.naive_bayes import BernoulliNB\n",
    "from sklearn.metrics import confusion_matrix, accuracy_score, f1_score, ConfusionMatrixDisplay"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3ee63e3e",
   "metadata": {},
   "source": [
    "## Getting the Data\n",
    "We get the mnist dataset from keras alreadly split into training and testing data. X_train and X_test contain the training and testing images as numpy arrays of pixels. Y_train and Y_test contain the digit labels for each image in X_train and X_test. We filter down to just two digits for our binary classification, choosing 7 and 9. To get the image data into a more workable form, we flatten them from 28x28 2D arrays down to a 1D array of 784 pixels, and we convert the pixels to a binary representation of black and white. These changes simplify our data from 2D arrays of greyscale pixels to a flat array of black and white pixels, which will then allow us to apply Bayesian classifiers to our data."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "66311a8f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Training samples: (12214, 784)\n",
      "Testing samples: (2037, 784)\n"
     ]
    }
   ],
   "source": [
    "# get the data\n",
    "(X_train, Y_train), (X_test, Y_test) = mnist.load_data()\n",
    "\n",
    "# Choose two digits\n",
    "digit1 = 7\n",
    "digit2 = 9\n",
    "\n",
    "# Keeping only the selected digits\n",
    "train_mask = (Y_train == digit1) | (Y_train == digit2)\n",
    "test_mask = (Y_test == digit1) | (Y_test == digit2)\n",
    "\n",
    "X_train = X_train[train_mask]\n",
    "Y_train = Y_train[train_mask]\n",
    "\n",
    "X_test = X_test[test_mask]\n",
    "Y_test = Y_test[test_mask]\n",
    "\n",
    "# Flattening images from 28x28 to 784 pixels\n",
    "X_train = X_train.reshape(-1, 784)\n",
    "X_test = X_test.reshape(-1, 784)\n",
    "\n",
    "# Convert to float for later calculations\n",
    "X_train = X_train.astype(float)\n",
    "X_test = X_test.astype(float)\n",
    "\n",
    "print(\"Training samples:\", X_train.shape)\n",
    "print(\"Testing samples:\", X_test.shape)\n"
   ]
  },
